# ─────────────────────────────────────────────────────────────
# Настройки контент-завода
#
# Руками это заполнять не нужно.
# Открой папку в Claude Code и напиши «настрой меня» — он спросит по одному,
# проверит каждый ключ и запишет всё сам.
#
# Без Claude Code:  node setup.js
# Проверить настройку: node setup.js --verify
#
# Если всё же заполняешь руками — скопируй этот файл в .env и впиши значения.
# Ключи — как пароли. Никому не показывай, в интернет не выкладывай.
# ─────────────────────────────────────────────────────────────


# ═══ ОБЯЗАТЕЛЬНО — без этого завод не запустится ═══

# Мозг завода. console.anthropic.com → API Keys
# ВАЖНО: пополни баланс в Plans & Billing, иначе ключ не работает.
ANTHROPIC_API_KEY=

# Главный бот — присылает тебе черновики. Создать: @BotFather → /newbot
TELEGRAM_BOT_TOKEN_6=

# Группа, куда бот пишет черновики. Id с минусом, например -1001234567890
TELEGRAM_APPROVAL_CHAT_ID=


# ═══ ЖЕЛАТЕЛЬНО — заметно добавляет возможностей ═══

# Расшифровка голосовых заданий. console.groq.com/keys (бесплатный лимит)
GROQ_API_KEY=

# Если в группе включены «Темы» — id нужной темы. Нет тем — оставь пустым.
TELEGRAM_APPROVAL_TOPIC_ID=

# Твой ник в Instagram без собачки — идёт на слайды и обложки
INSTAGRAM_USERNAME=

# Поиск свежих новостей твоей ниши. app.tavily.com (бесплатно до 1000 запросов)
TAVILY_API_KEY=

# Google — нужен только для фото на обложках каруселей.
# Содержимое JSON сервисного аккаунта ОДНОЙ строкой. Инструкция в ДОСТУПЫ.md
GOOGLE_SERVICE_ACCOUNT_JSON=

# Id папки с твоими фото на Google Диске (часть адреса после /folders/)
GOOGLE_PHOTOS_FOLDER_ID=


# ═══ ПО ЖЕЛАНИЮ ═══

# Автопостинг. postmypost.ru
POSTMYPOST_API_TOKEN=
POSTMYPOST_PROJECT_ID=

# Твой публичный Telegram-канал без собачки — завод смотрит, что уже выходило
TELEGRAM_CHANNEL_USERNAME=

# Основной канал для публикации (id с минусом)
TELEGRAM_MAIN_CHANNEL_ID=

# Тренды роликов в нише. console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=

# Контент-план в Google Таблице (id из адреса таблицы)
GOOGLE_SHEETS_ID=

# Ники в подвале гайдов, например: @nick · t.me/channel
GUIDE_NICKS=

# Threads — автопилот постинга
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_AUTOPILOT=off

# Отдельные боты для агентов. Не задал — все пишут через главный бот выше.
TELEGRAM_BOT_TOKEN_1=
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_BOT_TOKEN_3=
TELEGRAM_BOT_TOKEN_4=
TELEGRAM_BOT_TOKEN_5=

# Личный чат для отдельных уведомлений
TELEGRAM_CHAT_ID=

# Тема для свободных рассуждений с ботом
TELEGRAM_BRAINSTORM_TOPIC_ID=


# ═══ РАСПИСАНИЕ ═══

# Часовой пояс
TZ=Europe/Moscow

# Когда запускать утренний автопрогон (по умолчанию 7:30)
DAILY_CRON_EXPR=30 7 * * *

# Выключить утренний автопрогон совсем: DAILY_CRON=off
DAILY_CRON=

# Когда постить в Threads
THREADS_CRON_EXPR=0 7 * * *
